{
  "name": "Windows 98",
  "primaryColor": "#C0C0C0",
  "colors": {
    "buttonPrimaryText": "#000000",
    "buttonPrimaryBorder": "#000000",
    "buttonSecondaryText": "#000000",
    "buttonSecondaryBackground": "#C0C0C0",
    "buttonSecondaryBorder": "#C0C0C0",
    "cardBackground": "#C0C0C0",
    "cardBorder": "#808080",
    "inputBackground": "#FFFFFF",
    "inputBorder": "#808080",
    "link": "#0000EE",
    "headingText": "#000000",
    "bodyText": "#000000",
    "containerBackground": "#C0C0C0",
    "containerBorder": "#000000",
    "divider": "#808080",
    "icon": "#000000",
    "loader": "#000080",
    "positive": "#008000",
    "critical": "#FF0000",
    "information": "#000080",
    "hover": "#D4D0C8",
    "focus": "#000080"
  },
  "pageBackground": {
    "backgroundColor": "#008080"
  },
  "typography": {
    "text": {
      "faces": [
        { "url": "https://cdn.jsdelivr.net/npm/98.css@0.1.21/fonts/converted/ms_sans_serif.woff2", "weight": 400 },
        { "url": "https://cdn.jsdelivr.net/npm/98.css@0.1.21/fonts/converted/ms_sans_serif_bold.woff2", "weight": 700 }
      ],
      "sizeAdjust": 110
    }
  },
  "container": {
    "contentAlignment": "left",
    "logoAlignment": "center",
    "logoPosition": "inside"
  },
  "borders": {
    "buttonBorderRadius": 0.1,
    "buttonBorderWidth": 1,
    "cardBorderRadius": 0.1,
    "cardBorderWidth": 1,
    "inputBorderRadius": 0.1,
    "inputBorderWidth": 1,
    "containerBorderRadius": 0.1
  },
  "links": {
    "underline": true
  },
  "shadows": {
    "enabled": false
  }
}
